# Copy to .env — or skip this file entirely: on a laptop with
# ~/.config/azure-apim/apim-ssattiraju-01.env present, loop/models.py reads the gateway
# and key from there. The hosted container gets the same names from azure.yaml.
APIM_GATEWAY_URL=https://<apim>.azure-api.net
APIM_SUBSCRIPTION_KEY=

# Any deployment behind the gateway. claude-* ids route to the Anthropic API, everything
# else to /openai/v1. Swap models here and nowhere else.
LOOP_MODEL=gpt-5.6-luna

# What the hosted agent runs. Paths are relative to this directory.
LOOP_CHARTER=charters/claims_analyst.yaml
LOOP_DATA=data/claims.csv
LOOP_MAX_ITERATIONS=6
# Where ledgers and reports go. Defaults to ~/runs, which Foundry persists per session.
# LOOP_RUNS_DIR=

# Optional: the Foundry toolbox (skills + reference tools) as an MCP tool. Take the value
# from the azd env after `azd ai toolbox create` (TOOLBOX_STRONG_LOOP_TOOLBOX_MCP_ENDPOINT).
# Needs Azure credentials (az login locally; managed identity in the container).
# TOOLBOX_ENDPOINT=
# Optional: TypeSafe ranks closed-set column mappings when lexical intake matching has
# no candidates. It never certifies evidence and intake degrades to lexical-only without it.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest